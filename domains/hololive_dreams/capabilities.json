{
  "schema_version": 1,
  "domain": "hololive_dreams",
  "description": "面向模型的执行接口，不含模型服务连接配置或密钥。",
  "capabilities": [
    {
      "id": "hololive_dreams.launch_game",
      "description": "启动游戏并处理已有登录/奖励，进入自由主界面",
      "requires": "可以在无游戏窗口时调用",
      "input_schema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "outcome": {
            "type": "string",
            "enum": [
              "success",
              "unknown",
              "failure",
              "cancelled"
            ]
          },
          "verified": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "trace_directory": {
            "type": "string"
          }
        },
        "required": [
          "outcome",
          "verified"
        ],
        "additionalProperties": true
      },
      "result_semantics": "仅专用识别证据可 verified=true；输入发送或进程退出不等于游戏目标完成。",
      "retry_policy": "never_automatic",
      "output_notes": "可选字段取决于实际执行阶段；引用前核对结果。额外领域证据原样保留。"
    },
    {
      "id": "hololive_dreams.daily_tasks",
      "description": "执行选择的每日任务；可临时覆盖路线、识别阈值和等待预算",
      "requires": "用户要求日常；不购买、不追做未完成目标",
      "input_schema": {
        "type": "object",
        "properties": {
          "request": {
            "type": "object",
            "properties": {
              "selected_tasks": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "holowork",
                    "holo_home",
                    "the_cell",
                    "kaogan",
                    "wheel",
                    "greed_cards_entry",
                    "greed_cards_play",
                    "achievements",
                    "events",
                    "task_pass"
                  ]
                },
                "maxItems": 10
              },
              "record_rewards": {
                "type": "boolean"
              },
              "redispatch_holowork": {
                "type": "boolean"
              },
              "max_rounds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000
              },
              "max_loss": {
                "type": "integer",
                "minimum": 50,
                "maximum": 10000000
              },
              "unknown_notification_policy": {
                "type": "string",
                "enum": [
                  "ignore_run",
                  "stop"
                ]
              },
              "config_overrides": {
                "type": "object",
                "properties": {
                  "template_threshold": {
                    "type": "number",
                    "minimum": 0.01,
                    "maximum": 1
                  },
                  "nearby_walk_step_seconds": {
                    "type": "number",
                    "minimum": 0.01,
                    "maximum": 30
                  },
                  "nearby_walk_max_seconds": {
                    "type": "number",
                    "minimum": 0.01,
                    "maximum": 120
                  },
                  "teleport_wait_seconds": {
                    "type": "number",
                    "minimum": 0.01,
                    "maximum": 30
                  },
                  "click_interval_seconds": {
                    "type": "number",
                    "minimum": 0.01,
                    "maximum": 120
                  },
                  "transition_timeout_seconds": {
                    "type": "number",
                    "minimum": 0.01,
                    "maximum": 120
                  },
                  "notification_scroll_pages": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10
                  },
                  "holo_home_route": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "key": {
                          "type": "string",
                          "enum": [
                            "w",
                            "a",
                            "s",
                            "d"
                          ]
                        },
                        "seconds": {
                          "type": "number",
                          "minimum": 0.01,
                          "maximum": 30
                        }
                      },
                      "required": [
                        "key",
                        "seconds"
                      ],
                      "additionalProperties": false
                    },
                    "maxItems": 50
                  },
                  "attention_fixed_region": {
                    "type": "object",
                    "properties": {
                      "enabled": {
                        "type": "boolean"
                      },
                      "x_ratio": {
                        "type": "number",
                        "minimum": 0.02,
                        "maximum": 0.98
                      },
                      "y_ratio": {
                        "type": "number",
                        "minimum": 0.02,
                        "maximum": 0.98
                      }
                    },
                    "required": [
                      "enabled",
                      "x_ratio",
                      "y_ratio"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [],
                "additionalProperties": false
              }
            },
            "required": [],
            "additionalProperties": false
          },
          "startup": {
            "type": "boolean",
            "default": true
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "outcome": {
            "type": "string",
            "enum": [
              "success",
              "unknown",
              "failure",
              "cancelled"
            ]
          },
          "verified": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "trace_directory": {
            "type": "string"
          }
        },
        "required": [
          "outcome",
          "verified"
        ],
        "additionalProperties": true
      },
      "result_semantics": "仅专用识别证据可 verified=true；输入发送或进程退出不等于游戏目标完成。",
      "retry_policy": "never_automatic",
      "output_notes": "可选字段取决于实际执行阶段；引用前核对结果。额外领域证据原样保留。"
    },
